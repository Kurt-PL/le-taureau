C DRF_C3Cex
{ [y] = 0; [x] = 0; [c] = 0; }
P0 (atomic_int* y, atomic_int* x, atomic_int* c) {
  int r1 = atomic_load_explicit(y, memory_order_relaxed);
  if (r1 == 1) {
    atomic_store_explicit(x, 1, memory_order_relaxed);
  } else {
    atomic_store_explicit(c, 1, memory_order_relaxed);
    int r2 = atomic_load_explicit(c, memory_order_relaxed);
    if (r2 == 0) {
      atomic_store_explicit(x, 1, memory_order_relaxed);
    }
  }
}
P1 (atomic_int* x, atomic_int* y) {
  int r3 = atomic_load_explicit(x, memory_order_relaxed);
  if (r3 == 1) {
    atomic_store_explicit(y, 1, memory_order_relaxed);
  }
}
exists (0:r1=1 /\ 1:r3=1)
